# Godot-generated caches and local state
*.gen.*
.godot/
.import/
mono_crash.*.json

# Build outputs. Keep only the extension manifest and its stable Godot UID.
/bin/**
/project/bin/*
!/project/bin/*.gdextension
!/project/bin/*.gdextension.uid
/build/
/out/

# SCons and compiler intermediates
.sconsign*.dblite
.sconf_temp/
.scons-cache/

# Ignore custom.py
custom.py

# Ignore generated compile_commands.json
compile_commands.json

# Ignore files generated for documentation
/src/gen

# Binaries
*.o
*.os
*.so
*.obj
*.bc
*.pyc
*.dblite
*.pdb
*.lib
*.a
*.dll
*.dylib
*.wasm
*.exe
*.pck
*.config
*.creator
*.creator.user
*.files
*.includes
*.idb
*.exp

# Logs, crash dumps, temporary files, and editor backups
*.log
*.log.*
*.dmp
*.stackdump
*.tmp
*.temp
*.bak
*.old
*.orig
*.rej
*~
~$*

# Test and language caches
__pycache__/
.pytest_cache/
.cache/
.coverage
htmlcov/

# VSCode
.vscode/*
!.vscode/extensions.json
.DS_Store

# Jetbrains
.idea/

# Cmake
cmake-build*
CMakeUserPresets.json

# Local credentials and signing material
.env
.env.*
!.env.example
!.env.*.example
credentials.*
secrets.*
service-account*.json
auth.json
.npmrc
.pypirc
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.kdbx
*.ovpn
