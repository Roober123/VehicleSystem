<?xml version="1.0" encoding="UTF-8" ?>
<class name="VehicleConfig" inherits="Resource" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/godotengine/godot/master/doc/class.xsd">
	<brief_description>
		One-shot aggregate of Vehicle setup resources.
	</brief_description>
	<description>
		VehicleConfig supplies the resources consumed during one-shot Vehicle initialization. Engine, gearbox, and suspension data are required. Aerodynamics and turbo data are optional. When two driven axles are configured, [member center_differential_data] is required to solve their weighted carrier coordinate. VehicleSetupValidation reports missing major resources and invalid topology before runtime state is configured; changing this resource after initialization does not reconfigure the Vehicle.
	</description>
	<tutorials>
	</tutorials>
	<methods>
		<method name="set_engine_data" qualifiers="">
			<return type="void" /><param index="0" name="data" type="VehicleEngineData" />
			<description>Sets required engine configuration data.</description>
		</method>
		<method name="get_engine_data" qualifiers="const">
			<return type="VehicleEngineData" /><description>Returns engine configuration data.</description>
		</method>
		<method name="set_gearbox_data" qualifiers="">
			<return type="void" /><param index="0" name="data" type="GearboxData" />
			<description>Sets required gearbox and clutch configuration data.</description>
		</method>
		<method name="get_gearbox_data" qualifiers="const">
			<return type="GearboxData" /><description>Returns gearbox and clutch configuration data.</description>
		</method>
		<method name="set_suspension_data" qualifiers="">
			<return type="void" /><param index="0" name="data" type="SuspensionData" />
			<description>Sets required suspension configuration data.</description>
		</method>
		<method name="get_suspension_data" qualifiers="const">
			<return type="SuspensionData" /><description>Returns suspension configuration data.</description>
		</method>
		<method name="set_aero_data" qualifiers="">
			<return type="void" /><param index="0" name="data" type="VehicleAerodynamicsData" />
			<description>Sets optional aerodynamics configuration data.</description>
		</method>
		<method name="get_aero_data" qualifiers="const">
			<return type="VehicleAerodynamicsData" /><description>Returns optional aerodynamics configuration data.</description>
		</method>
		<method name="set_turbo_data" qualifiers="">
			<return type="void" /><param index="0" name="data" type="TurboData" />
			<description>Sets optional turbo configuration data.</description>
		</method>
		<method name="get_turbo_data" qualifiers="const">
			<return type="TurboData" /><description>Returns optional turbo configuration data.</description>
		</method>
		<method name="set_center_differential_data" qualifiers="">
			<return type="void" /><param index="0" name="data" type="DifferentialData" />
			<description>Sets the center differential required when two driven axles are present.</description>
		</method>
		<method name="get_center_differential_data" qualifiers="const">
			<return type="DifferentialData" /><description>Returns optional center differential configuration.</description>
		</method>
	</methods>
	<members>
		<member name="engine_data" type="VehicleEngineData" setter="set_engine_data" getter="get_engine_data">Required engine data.</member>
		<member name="gearbox_data" type="GearboxData" setter="set_gearbox_data" getter="get_gearbox_data">Required gearbox and clutch data.</member>
		<member name="suspension_data" type="SuspensionData" setter="set_suspension_data" getter="get_suspension_data">Required suspension data.</member>
		<member name="aero_data" type="VehicleAerodynamicsData" setter="set_aero_data" getter="get_aero_data">Optional aerodynamics data.</member>
		<member name="turbo_data" type="TurboData" setter="set_turbo_data" getter="get_turbo_data">Optional turbo data.</member>
		<member name="center_differential_data" type="DifferentialData" setter="set_center_differential_data" getter="get_center_differential_data">Center differential data required for two driven axles.</member>
	</members>
</class>
